# ─── App ──────────────────────────────────────────────────────────────────────
# Dev qiymatlari docker-compose.dev.yml host portlariga mos (go run ./cmd — xostda).
# Productionда (deployments/docker-compose.yml) app konteyner ichida ishlaydi va
# infraga konteyner tarmog'i orqali ulanadi: DB_HOST=postgres DB_PORT=5432,
# REDIS 6379, MINIO 9000, RABBITMQ 5672. O'sha holat uchun bu qiymatlarni moslang.
APP_PORT=8087
APP_ENV=development
LOG_LEVEL=info
FRONTEND_BASE_URL=http://localhost:3000
# MVP: hamma ro'yxatdan o'ta oladi. Productionda false qilib invite oqimidan foydalaning.
ALLOW_OPEN_REGISTRATION=true
# Parol hash narxi (10-11 tavsiya). Yuqori = xavfsizroq lekin login/join'da ko'proq CPU
# (1000 talaba bir vaqtda kirsa thundering-herd). Bcrypt semaphore NumCPU bilan cheklangan.
BCRYPT_COST=11
# Seed-admin — foydalanuvchilarni boshqarish (users CRUD) faqat `admin` rolida (H-2).
# Ikkalasi ham to'ldirilsa, startupda shu email'li admin YO'Q bo'lsa yaratiladi (idempotent).
# Bo'sh qoldirilsa hech narsa qilinmaydi. Ishga tushgach parolni o'zgartirish tavsiya etiladi.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5442
DB_NAME=darsly
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNS=50
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=1m
# DATABASE_URL=postgres://postgres:postgres@localhost:5442/darsly?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6399
REDIS_PASSWORD=
REDIS_DB=0
# Pool (0 → go-redis default 10×GOMAXPROCS). Yuqori concurrency'da aniq bering.
REDIS_POOL_SIZE=0
REDIS_MIN_IDLE_CONNS=0

# ─── MinIO (dars yozuvlari — Egress shu yerga yozadi) ─────────────────────────
MINIO_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=darsly
MINIO_USE_SSL=false
# Egress konteyneri MinIO'ga yozadi — u uchun docker-reachable manzil (bo'sh bo'lsa http://MINIO_ENDPOINT).
# Recording (5-bosqich) uchun: MINIO_S3_ENDPOINT=http://172.17.0.1:9020
# Presigned yuklab-olish URL'lari shu OCHIQ endpointga imzolanadi (tashqi klient yeta oladigan).
# Bo'sh → ichki MINIO_ENDPOINT (faqat lokal ishlaydi). Production: files.darsly.uz
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=true

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Kamida 32 belgi: openssl rand -hex 32
JWT_SECRET=dev_secret_change_me_least_32_chars_long_000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Refresh rotatsiyasining idempotentlik ("grace") oynasi.
# Mobil tarmoqda rotatsiya javobi yo'qolsa yoki ilovada ikki parallel 401-retry ketsa,
# klient ALLAQACHON ishlatilgan refresh bilan qayta uradi. Shu oyna ichida server ayni
# o'sha juftlikni qaytaradi va sessiyani O'LDIRMAYDI (avval bu holat foydalanuvchining
# telefon+planshet+web sessiyalarini birdaniga uzardi). Oyna tashqarisida reuse haliyam
# token o'g'irligi deb baholanadi → butun sessiya-oilasi bekor qilinadi.
# Diqqat: oyna ichida Redis'da tayyor token juftligi saqlanadi — TTL'ni qisqa tuting.
# 0 → grace o'chirilgan (eski xatti-harakat). PRODUCTION'DA 0 QO'YMANG: grace'siz
# parallel refresh portlashida (ilova bir vaqtda bir necha 401-retry yuborsa) g'olibdan
# keyin kelgan so'rovlar "reuse" deb baholanadi va foydalanuvchi BARCHA qurilmadan
# chiqarib yuboriladi. QA buni empirik ko'rsatdi: grace=0 da 8 parallel refresh →
# 7×401 + boshqa qurilmadagi sessiya ham o'ldi; 60s da → 8/8 muvaffaqiyat, sessiyalar tirik.
JWT_REFRESH_GRACE=60s

# ─── SMTP (Email) — MVP'da o'chirilgan ────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=noreply@darsly.uz
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── LiveKit (SFU video server) ───────────────────────────────────────────────
LIVEKIT_HOST=ws://localhost:7880
# Klientlarga (telefon/brauzer) qaytariladigan signaling manzili — Host'dan ALOHIDA:
#   ""     — Host'ning o'zi;  "auto" — dev: so'rov hostidan yasaladi (LAN'da telefon
#   bilan sinash uchun);  production: wss://livekit.<domen>
LIVEKIT_CLIENT_WS_URL=auto
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_at_least_32_characters_long_000000
LIVEKIT_WEBHOOK_API_KEY=devkey
# Kirish tokeni muddati — uzun darsda reconnect'da o'tib ketmasin (default 6h).
LIVEKIT_TOKEN_TTL=6h

# ─── RabbitMQ (recording event navbati) ───────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5682/

# ─── Rate limiting / xavfsizlik ───────────────────────────────────────────────
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
# Ishonchli reverse-proxy IP/CIDR ro'yxati (vergul bilan). Bo'sh → hech kimga
# ishonmaydi (ClientIP=RemoteAddr — proxysiz dev uchun to'g'ri).
# PRODUCTION (Caddy/nginx reverse-proxy ortida) MAJBURIY: aks holda ClientIP =
# proxy IP bo'lib qoladi → (a) rate-limit hamma foydalanuvchini bitta bucketga
# yig'adi, (b) real IP loglanmaydi (audit yo'qoladi). Docker bridge tarmog'i uchun:
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# Global bir vaqtdagi WebSocket ulanishlar chegarasi (DoS himoyasi). 0 = cheksiz.
WS_MAX_CONNECTIONS=10000
# WS upgrade uchun ruxsat etilgan Origin'lar (vergul bilan). Bo'sh bo'lsa
# FRONTEND_BASE_URL ishlatiladi (orqaga moslik). Bir nechta frontend/domen bo'lsa:
# WS_ALLOWED_ORIGINS=https://app.darsly.uz,https://admin.darsly.uz
WS_ALLOWED_ORIGINS=
# Origin header umuman YO'Q bo'lsa ruxsat berilsinmi (default true).
# Native mobil klientlar (Android/OkHttp, iOS) WS handshake'da Origin yubormaydi,
# brauzer esa uni HAR DOIM yuboradi → bo'sh Origin brauzerdan kelolmaydi, ya'ni
# CSWSH xavfi yo'q (auth baribir ?token= / Bearer JWT bilan). Faqat web bo'lsa false.
WS_ALLOW_EMPTY_ORIGIN=true

# ─── Dars eslatma worker'i ────────────────────────────────────────────────────
REMINDER_INTERVAL=60s   # tekshirish oralig'i
REMINDER_LEAD=15m       # dars boshlanishidan qancha oldin eslatma

# ─── Dars avto-yakuni (PRODUCT.md «Dars hayoti») ──────────────────────────────
# Mentor "Yakunlash"ni bosmasligi mumkin (telefon o'chdi, ilova yopildi), shuning
# uchun ikkala qoida ham SERVER tomonda bajariladi.
# Texnik limit: dars boshlanganidan shuncha vaqt o'tsa avtomatik yakunlanadi. 0 = limitsiz.
LESSON_MAX_DURATION=4h
# Xona bo'shagach shuncha kutiladi, keyin dars yakunlanadi. 0 = qoida o'chirilgan.
# ⚠️ LiveKit `empty_timeout` (xonaning O'ZI o'chishi) bilan aralashtirmang — bu DARS holati.
LESSON_EMPTY_GRACE=20m
# Avto-yakun tekshiruvi oralig'i.
LESSON_SWEEP_INTERVAL=1m

# ─── Yozuvlar retention (PRODUCT.md №5 + Telegram arxivi) ─────────────────────
# Server nusxasi shuncha KUN turadi.
#
# ⚠️ TELEGRAM YOQILGAN bo'lsa o'chirish SHARTLI bo'ladi: fayl faqat Telegramda
# TASDIQLANGAN bo'lsa o'chiriladi va yozuv `archived` bo'ladi (yo'qolmaydi —
# ochilganda qaytariladi). Tasdiqlanmagani serverda QOLADI va mentor
# ogohlantiriladi. Telegram o'chiq bo'lsa eski xulq: `expired` (butunlay o'chadi).
#
# RECORDING_SERVER_RETENTION_DAYS — yangi nom; berilmasa eski
# RECORDING_RETENTION_DAYS ishlatiladi (mavjud serverlarni buzmaslik uchun).
RECORDING_SERVER_RETENTION_DAYS=30
RECORDING_RETENTION_DAYS=30
# O'chishdan shuncha kun oldin mentorga bildirishnoma yuboriladi. 0 = ogohlantirish yo'q.
RECORDING_RETENTION_WARN_DAYS=3
# Retention tekshiruvi oralig'i (kunlar bilan o'lchanadigan siyosat uchun soat yetarli).
RECORDING_RETENTION_INTERVAL=1h
# Telegramdan QAYTARIB olingan nusxa serverda necha soat turadi, keyin yana
# o'chiriladi (Telegramdagi asl nusxa tegilmaydi).
RECORDING_CACHE_TTL_HOURS=24

# RECORDING_MODE — yozuv qanday olinadi:
#   (bo'sh) / egress → server LiveKit Egress bilan yozadi (Chrome-composite; kuchsiz
#            serverda kadr tashlaydi → sifat past).
#   local           → CLIENT-SIDE: telefon darsni O'ZI to'liq sifatda yozib serverga
#            yuklaydi («Zoom local recording»). Server egress AVTOMATIK boshlanmaydi.
#            Qo'lda StartRecording (egress) fallback baribir ochiq qoladi.
RECORDING_MODE=

# ─── Telegram arxivi (PRODUCT.md «Dars arxivi va Telegram saqlash») ───────────
#
# ⭐ HAMMASI IXTIYORIY. TELEGRAM_BOT_TOKEN bo'sh bo'lsa integratsiya BUTUNLAY
# o'chiq: hech bir ishchi ishga tushmaydi, hech qanday xato bo'lmaydi va
# yozib olish avvalgidek ishlaydi (Sentry bilan bir xil naqsh).
#
# To'liq sozlash qo'llanmasi (qadamma-qadam): docs/telegram-setup.md
#
# @BotFather bergan token. Bo'sh → integratsiya o'chiq.
TELEGRAM_BOT_TOKEN=
# my.telegram.org → API development tools. FAQAT Local Bot API Server
# konteyneri ishlatadi (backend'ning o'ziga kerak emas).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Local Bot API Server manzili. Bo'sh → rasmiy api.telegram.org va 50 MB
# chegara (1 soatlik dars SIG'MAYDI — shuning uchun production'da to'ldiring).
#   lokal dev: http://localhost:8081   (services/telegram-bot-api)
#   server:    http://telegram-bot-api:8081
TELEGRAM_API_URL=
# Doimiy arxiv guruhi — video HAR DOIM avtomatik shu yerga tushadi.
# Guruhlar manfiy ID bilan: -1001234567890. Bo'sh → avtomatik arxivlash o'chiq.
TELEGRAM_ARCHIVE_CHAT_ID=
# Bitta fayl chegarasi (MB). Local server bilan 2000 gacha; 1900 — xavfsiz zapas.
TELEGRAM_UPLOAD_MAX_MB=1900
# Local Bot API Server fayllari backend konteynerida qayerga ulangan.
# Tiklashda fayl HTTP orqali emas, to'g'ridan-to'g'ri diskdan o'qiladi.
TELEGRAM_FILE_ROOT=/var/lib/telegram-bot-api

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Grafana Loki (optional) ──────────────────────────────────────────────────
LOKI_URL=
LOKI_USER=
LOKI_PASSWORD=

# ─── OpenTelemetry tracing (optional) ─────────────────────────────────────────
# Bo'sh bo'lsa tracing o'chiq (no-op, overhead yo'q). Masalan: http://tempo:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── DB ───────────────────────────────────────────────────────────────────────
DB_STATEMENT_TIMEOUT_MS=8000   # web-request uchun; osilgan so'rov ulanishni band qilmasin

# ─── Auth rate-limit (BE-11: mobil operator CGNAT'i ostida) ───────────────────
# Mobil operator (Ucell/Beeline) CGNAT'i ortida MINGLAB abonent bitta chiqish IP'sida
# bo'ladi. Shuning uchun login/refresh faqat IP bo'yicha cheklanmaydi — har biri o'z
# ma'noli o'lchamiga ega (asos: api/middleware/ratelimit_auth.go). Barchasi 1 daqiqa oynada.
#
# Login — uch qatlam (brute-force himoyasi KUCHAYADI, kuchsizlanmaydi):
RATE_LIMIT_LOGIN_IP_EMAIL=10   # (IP+email): bitta joydan bitta akkauntga nishonli urinish
RATE_LIMIT_LOGIN_EMAIL=30      # email bo'yicha, IP'dan qat'i nazar → taqsimlangan hujum to'siladi
RATE_LIMIT_LOGIN_IP=200        # IP shifti: credential stuffing/DoS chegarasi (CGNAT uchun saxiy)
#
# Refresh — sessiya bo'yicha (refresh tokenni taxmin qilib bo'lmaydi, brute-force yo'q;
# haqiqiy xavf resurs DoS'i → uni IP shifti qoplaydi):
RATE_LIMIT_REFRESH_SID=30      # bitta sessiya (sid) uchun
RATE_LIMIT_REFRESH_IP=600      # IP shifti
#
# register / forgot-password / reset-password — spam vektorlari, IP bo'yicha qoladi:
RATE_LIMIT_AUTH_IP=60

# ─── Mobil ilova versiya nazorati (GET /api/v1/app-config, ochiq) ─────────────
# Side-load qilingan APK'da avtomatik yangilanish YO'Q — buzuq versiyani to'xtatishning
# yagona yo'li shu endpoint. Klient ishga tushganda min_version'ni tekshiradi.
APP_ANDROID_MIN_VERSION=1.0.0        # shu versiyadan past klient ishlamaydi (semver)
APP_ANDROID_LATEST_VERSION=1.0.0     # eng yangi versiya (yumshoq taklif)
APP_ANDROID_APK_URL=                 # yuklab olish havolasi, masalan https://app.<ip>.sslip.io/download/darsly-mentor.apk
APP_ANDROID_FORCE_UPDATE=false       # true → versiyadan qat'i nazar majburiy yangilash (favqulodda to'xtatish)
APP_ANDROID_RELEASE_NOTES=           # foydalanuvchiga ko'rsatiladigan o'zgarishlar matni
