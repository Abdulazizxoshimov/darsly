<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Fon rejimi: ekran ulashish + mikrofon + kamera dars davomida uzilmasligi uchun -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Android 13+ (API 33): bildirishnoma ko'rsatish uchun runtime ruxsat -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Efir-ramka: ekran ulashish/yozuv paytida BOSHQA ilovalar ustida ham
         ko'rinadigan rangli hoshiya (ShareFrameOverlay). Foydalanuvchi
         sozlamalardan ruxsat beradi; bermasa ramka shunchaki chiqmaydi. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Qo'l ko'tarilganda qisqa titrash. Ustoz ekran ulashib boshqa ilovada
         bo'lganda bu YAGONA e'tibor torttiruvchi signal: bildirishnoma kanali
         `IMPORTANCE_LOW` (ovozsiz), overlay esa MediaProjection'ga tushib
         o'quvchilarga ko'rinib qolardi. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".DarslyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DarslyMentor"
        tools:targetApi="35">

        <!-- Sentry AVTO-init o'chirilgan: init qo'lda DarslyApp.initCrashReporting()
             da (DSN bo'sh bo'lsa SDK umuman yoqilmaydi). Busiz kutubxonaning
             SentryInitProvider'i Application'dan OLDIN ishga tushib, DSN'siz
             (har qanday lokal/dev build) "DSN is required" bilan quladi. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.DarslyMentor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Dars foreground service'i — LiveKit Room shu servis "ichida" yashaydi
          (LessonSessionHolder orqali), ustoz boshqa ilovaga o'tsa dars uzilmaydi.
          Tип: mediaProjection|microphone|camera — uchtasi ham kerak, chunki
          ekran ulashish + mikrofon + kamera bir vaqtda fon rejimida ishlaydi.
        -->
        <service
            android:name=".service.LessonService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone|camera" />

        <!--
          LiveKit SDK o'zining ScreenCaptureService'ini AndroidManifest'ida
          android:foregroundServiceType="mediaProjection" bilan e'lon qiladi.
          Ekran AUDIOSI (AudioPlaybackCapture) fon rejimida ishlashi uchun esa
          `microphone` tipi ham kerak (SDK hujjatidagi talab), shuning uchun
          manifest merger orqali tipni kengaytiramiz.
        -->
        <service
            android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection|microphone"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
