<!--
  Jonly ilova ikonkasi — "jon pulsi" chizig'i (brend B konsepsiyasi).

  MAZMUN: puls chizig'i — "jonli dars" metaforasi: dars boshlandi, yurak urdi,
  bilim oqyapti. Fon — okean (#0E2233, @color/ic_launcher_background),
  chiziq — brend minti (#19D3A2). Harf ATAYLAB ishlatilmadi: launcher ikonkasi
  ro'yxatda ~48dp da ko'rsatiladi va u o'lchamda harf o'qilmaydigan dog'ga
  aylanadi; puls silueti esa kichikda ham aniq o'qiladi.

  ⚠️ XAVFSIZ ZONA: adaptiv ikonka 108dp, lekin chetini tizim niqobi
  (doira/squircle/rounded) KESADI. Ko'rinishi kafolatlangan qism — markazdagi
  ~66dp doira. Puls chizig'i 27..81 oralig'ida turadi; undan chetga chiqsa
  Pixel/Samsung niqoblarida qirqilardi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Puls chizig'i: tekis → ko'tarilish → tushish → tekis -->
    <path
        android:pathData="M27,55.5 L39.5,55.5 L47,37 L58,71.5 L64.5,55.5 L81,55.5"
