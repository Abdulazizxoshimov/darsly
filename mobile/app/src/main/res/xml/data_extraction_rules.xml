<?xml version="1.0" encoding="utf-8"?>
<!--
  M1 — sessiya tokenlari qurilmadan chiqmasligi kerak.

  `android:allowBackup="false"` bulutli zaxiralashni to'sadi, lekin Android 12+ dagi
  **qurilmadan-qurilmaga ko'chirish** (D2D) uni chetlab o'tadi. Shifrlangan preferens
  fayli boshqa telefonga ko'chsa u yerda Keystore kaliti bo'lmaydi — natijada eng
  yaxshi holatda o'qib bo'lmaydigan fayl, eng yomonida esa keraksiz sizib chiqish
  yuzasi. Shuning uchun ikkala kanaldan ham chiqarib tashlaymiz.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="darsly_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="darsly_session.xml" />
    </device-transfer>
</data-extraction-rules>
