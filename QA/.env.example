# Darsly QA muhiti — nusxa ko'chir: cp .env.example .env
# (.env git'ga TUSHMAYDI — sirlar shu yerda)

# ── Target profil ───────────────────────────────────────────────
# local dev backend (docker compose -f backend/docker-compose.dev.yml up -d + go run ./cmd)
QA_BASE_URL=http://localhost:8087

# WebSocket bazasi (bo'sh bo'lsa QA_BASE_URL'dan http->ws almashtirib olinadi)
# QA_WS_URL=ws://localhost:8087

# Seed admin — test foydalanuvchilarni yaratish uchun (local backend .env bilan mos).
# Ochiq registratsiya yopiq bo'lgani uchun test userlar admin API orqali yaratiladi.
QA_SEED_ADMIN_EMAIL=admin@darsly.uz
QA_SEED_ADMIN_PASSWORD=Admin12345

# ── Monitoring (prod-monitor profili — keyingi bosqich) ─────────
# QA_BASE_URL=https://app.169.58.104.245.sslip.io
QA_MONITOR_EMAIL=qa+monitor@darsly.uz
QA_MONITOR_PASSWORD=

# ── LiveKit webhook imzo (test_webhooks — «to'g'ri imzo → 200») ─
# Backend .env dagi LIVEKIT_WEBHOOK_API_KEY / LIVEKIT_API_SECRET bilan mos bo'lsin.
# Local default (services/livekit): devkey / secret_at_least_32_characters_long_000000
QA_LIVEKIT_WEBHOOK_KEY=devkey
QA_LIVEKIT_WEBHOOK_SECRET=secret_at_least_32_characters_long_000000

# ── Telegram alert (GitHub Secrets'da saqlanadi) ────────────────
QA_TG_BOT_TOKEN=
QA_TG_CHAT_ID=
