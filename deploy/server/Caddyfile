# Darsly — Caddy (avtomatik Let's Encrypt HTTPS).
# app.<IP>.sslip.io  → SPA + /api + /ws (yagona origin, CORS yo'q)
# livekit.<IP>.sslip.io → LiveKit signaling (wss), host-network livekit:7880 ga.
#
# sslip.io: <anything>.194.163.139.242.sslip.io → 194.163.139.242 (real DNS).
# HTTP-01 ACME uchun 80/443 ochiq bo'lishi shart (ufw).

app.194.163.139.242.sslip.io {
	encode zstd gzip

	# API + WebSocket (backend konteyneri, bir tarmoqda).
	handle /api/* {
		reverse_proxy darsly-backend:8080
	}

	# Mobil ilova APK'sini tarqatish (QR kod → shu URL). deploy/server/dl katalogi.
	# SPA fallback'dan OLDIN turishi shart, aks holda index.html qaytardi.
	handle /download/* {
		root * /srv-dl
		uri strip_prefix /download
		file_server browse
	}

	# SPA (Vite build). Klient-side routing uchun index.html fallback.
	handle {
		root * /srv

		# ── Xavfsizlik sarlavhalari (M5) ────────────────────────────────────
		#
		# Nega bu yerda: backend'da `SecurityHeaders()` middleware'i bor, lekin u
		# FAQAT /api/* javoblariga tegadi. HTML hujjatni esa Caddy to'g'ridan-to'g'ri
		# /srv dan beradi — ya'ni brauzer ko'radigan ASOSIY sahifa hech qanday
		# himoyasiz kelardi. Clickjacking va XSS to'sig'i aynan hujjat darajasida
		# ishlaydi, JSON javoblarida emas.
		#
		# ⚠️ DIQQAT — Permissions-Policy: backend'dagi qiymat `camera=(), microphone=()`,
		# ya'ni HAMMASI taqiqlangan. Uni bu yerga KO'CHIRIB BO'LMAYDI: hujjat
		# darajasida u kamera/mikrofonni butunlay o'chiradi va dars umuman
		# ishlamaydi. Shuning uchun bu yerda `(self)` — o'z originimizga ruxsat.
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
			# frame-ancestors 'none' — X-Frame-Options DENY ning zamonaviy varianti
			# (ikkalasi ham qo'yiladi: eski brauzerlar CSP'ni tushunmaydi).
			X-Frame-Options "DENY"
			# CSP manbalari (har biri build'dan tekshirilgan):
			#   script-src  — Vite build'da INLINE skript yo'q (dist/index.html tekshirildi),
			#                 shuning uchun 'unsafe-inline' KERAK EMAS. 'wasm-unsafe-eval'
			#                 esa LiveKit codec WASM'i uchun zarur.
			#   worker-src  — pdf.js worker'i o'z assetimiz; blob: pdf.js fallback'i uchun.
			#   style/font  — index.html Google Fonts'ni tashqaridan yuklaydi.
			#   img/media   — doska PDF sahifalarini dataURL, video esa blob sifatida beradi.
			#                 img-src'da MinIO subdomeni ham bor: chatga yuborilgan rasm
			#                 presigned havola bilan `files.<domen>` dan ko'rsatiladi
			#                 (ChatFileCard). Usiz rasm FAQAT deploydan keyin bloklanardi —
			#                 dev'da CSP yo'q, ya'ni muammo lokalda ko'rinmasdi.
			#   connect-src — API/WS o'z originimizda; LiveKit signaling va MinIO
			#                 yozuvlari alohida subdomenlarda.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://files.194.163.139.242.sslip.io; media-src 'self' blob:; connect-src 'self' blob: wss://livekit.194.163.139.242.sslip.io https://files.194.163.139.242.sslip.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		}

		# Hash'li assetlar — abadiy keshlanadi (fayl nomi kontent bilan o'zgaradi).
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		# index.html va SPA marshrutlari — HECH QACHON keshlanmaydi (har deploy darhol yetadi).
		@nostore {
			not path /assets/*
		}
		header @nostore Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

livekit.194.163.139.242.sslip.io {
	# host-network'dagi LiveKit'ga (7880) host-gateway orqali.
	reverse_proxy host.docker.internal:7880
}

# MinIO ochiq yuzi — FAQAT presigned URL'lar uchun (yozuvlarni yuklab olish).
# Nega kerak: presigned URL SigV4 imzosi Host header'ni ham qamrab oladi. Backend
# ichki 'minio:9000' ga imzolasa, brauzer bu hostga umuman yeta olmaydi → yozuv
# yuklanmaydi (web'da ham, mobilda ham). Shu sabab backend .env da
# MINIO_PUBLIC_ENDPOINT=files.<IP>.sslip.io + MINIO_PUBLIC_USE_SSL=true bo'ladi
# (backend config nomlari: internal/pkg/config/config.go:213-214).
#
# MUHIM: Caddy reverse_proxy Host header'ni DEFAULT saqlaydi (nginx'dan farqli) —
# shuning uchun MinIO imzoni aynan shu host bilan tekshiradi va imzo to'g'ri chiqadi.
# Bucket ochiq QILINMAYDI: imzosiz so'rov MinIO'ning o'zi tomonidan 403 bo'ladi.
files.194.163.139.242.sslip.io {
	# Yozuvlar yirik (100 MB+) — bufferlash YO'Q, oqim bilan uzatiladi.
	reverse_proxy darsly-minio:9000 {
		flush_interval -1
	}
}
