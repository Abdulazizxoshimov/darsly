# Backend API bazasi. Dev'da bo'sh qoldiring — Vite proxy (/api,/ws → :8087) ishlatiladi.
# Prod'da to'liq manzil: https://api.darsly.uz
VITE_API_URL=

# Parol-tiklash (email) oqimi. Backend'dagi EMAIL_ENABLED bilan mos bo'lishi kerak.
# Default `false` → SMTP o'chiq → "Parolni unutdim" havolasi UI'da ko'rinmaydi
# (email jimgina tashlanadi, yolg'on "yuborildi" bo'lmasin). SMTP yoqilganda `true` qiling.
VITE_EMAIL_ENABLED=false
